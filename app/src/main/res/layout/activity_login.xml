<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient"
    tools:context=".LoginActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <!-- Imagen Focus Club -->
    <ImageView
        android:src="@drawable/logo"
        android:layout_height="160dp"
        android:layout_width="160dp"
        android:contentDescription="@string/image_description"/>

    <TextView
        android:id="@+id/tvConfigurarSuperAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="@string/login_configurar_superadmin"
        android:textColor="@color/white"
        android:visibility="gone" />

    <!-- Usuario -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="@string/label_usuario"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etUsuario"
        style="@style/InputBase"
        android:hint="@string/hint_email"
        android:layout_marginTop="8dp"
        android:inputType="textNoSuggestions"
        android:autofillHints="username" />

    <!-- Contraseña -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="26dp"
        android:text="@string/label_contrasena"
        android:textColor="@color/white"
        android:textSize="14sp"
        android:textStyle="bold" />

    <EditText
        android:id="@+id/etContrasena"
        style="@style/InputBase"
        android:layout_marginTop="8dp"
        android:inputType="textPassword"
        android:autofillHints="password"
        android:saveEnabled="false"
        android:hint="@string/hint_contrasena" />

    <EditText
        android:id="@+id/etConfirmacionContrasena"
        style="@style/InputBase"
        android:layout_marginTop="12dp"
        android:inputType="textPassword"
        android:saveEnabled="false"
        android:hint="@string/login_confirmar_contrasena"
        android:visibility="gone" />

    <!-- Boton ingresar -->
    <Button
        android:id="@+id/btnIngresar"
        style="@style/ButtonPrimaryL"
        android:layout_marginTop="30dp"
        android:text="@string/btn_ingresar"
        android:gravity="center"
        tools:ignore="TextContrastCheck,VisualLintTextFieldSize" />

    <!-- Pie de página -->
    <TextView
        android:id="@+id/tvOlvidasteContrasena"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="center"
        android:text="@string/forgot_password"
        android:textSize="14sp"
        android:textColor="@color/white" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:gravity="center"
        android:text="@string/copyright"
        android:textColor="@color/white"
        android:textSize="12sp"/>

</LinearLayout>
</ScrollView>
