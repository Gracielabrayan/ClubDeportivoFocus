<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:id="@+id/txtVolverTarifas"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:gravity="center_vertical"
            android:text="@string/btn_volver"
            android:textColor="@color/primary"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/tarifas_titulo"
            android:textColor="@color/black"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/tarifas_alcance"
            android:textColor="@color/black"
            android:textSize="15sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:labelFor="@id/etTarifaMensual"
            android:text="@string/tarifas_mensual"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTarifaMensual"
            style="@style/InputBase"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_borde_texto"
            android:digits="0123456789,."
            android:inputType="numberDecimal"
            android:maxLength="12"
            android:maxLines="1" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:labelFor="@id/etTarifaDiaria"
            android:text="@string/tarifas_diaria"
            android:textColor="@color/black"
            android:textSize="14sp"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/etTarifaDiaria"
            style="@style/InputBase"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_borde_texto"
            android:digits="0123456789,."
            android:inputType="numberDecimal"
            android:maxLength="12"
            android:maxLines="1" />

        <Button
            android:id="@+id/btnGuardarTarifas"
            style="@style/ButtonPrimaryL"
            android:layout_marginTop="28dp"
            android:gravity="center"
            android:text="@string/tarifas_guardar" />
    </LinearLayout>
</ScrollView>
